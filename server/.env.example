# Copy to server/.env for local development. Never commit server/.env.
# Existing process environment variables take priority over this file.

# Required: whole TCP port number from 1 to 65535. 5000 is a safe local default.
PORT=5000

# Required: replace this placeholder locally with the private Atlas driver URI.
# Include the application database name. Never commit the real value.
MONGODB_URI=REPLACE_WITH_YOUR_PRIVATE_MONGODB_ATLAS_URI

# Optional: private redis:// or rediss:// connection URL (rediss uses TLS).
# Leave blank to skip Redis. A failed connection does not prevent API startup.
# Configure credentials privately; never commit the real URL.
REDIS_URL=

# Optional: agent-list cache lifetime in seconds (1-86400). Default when absent: 60.
# Entries are not invalidated after writes until Step 16.
AGENT_LIST_CACHE_TTL_SECONDS=60
