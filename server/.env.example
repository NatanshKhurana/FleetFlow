# Copy to server/.env for local development. Never commit server/.env.
# Existing process environment variables take priority over this file.

# Required: whole TCP port number from 1 to 65535. 5000 is a safe local default.
PORT=5000

# Optional until Step 4: private MongoDB connection configuration.
# Leave blank now. Never put real credentials in this example file.
MONGODB_URI=

# Optional until Step 13: private Redis connection configuration.
# Leave blank now. Neither service is contacted in Step 3.
REDIS_URL=
