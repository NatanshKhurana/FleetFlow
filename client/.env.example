# Public browser configuration only. Never put passwords, tokens, or database URLs here.
# Copy to client/.env for local overrides; restart Vite after changing it.
# Relative requests use Vite's local proxy and avoid cross-origin browser requests.
VITE_API_BASE_URL=/api

# Local development/preview only. Match the existing backend's normal port 5000.
# Change this public origin if the backend port changes. Never include credentials.
API_PROXY_TARGET=http://localhost:5000
